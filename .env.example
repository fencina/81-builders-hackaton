OPENAI_API_KEY=
BUSINESS_TIMEZONE=Asia/Tokyo
# Defaults to a local .data/shifts.db. Set a libSQL URL to share with another app.
SHIFTS_DATABASE_URL=
SHIFTS_DATABASE_AUTH_TOKEN=
SHIFT_POLL_ENABLED=true
SHIFT_POLL_INTERVAL_MS=300000
# Include the /api prefix. Use an authenticated, connected OpenWA session.
OPENWA_API_URL=http://localhost:2785/api
OPENWA_SESSION_ID=
OPENWA_API_KEY=
# Copy to .env.daytona. Never commit the real values.
DAYTONA_API_KEY=
OPENAI_API_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Manager WhatsApp number, including country code, for shift change approvals.
SHIFT_MANAGER_PHONE=

# Demo seed: use your test WhatsApp number, including country code.
DEMO_EMPLOYEE_PHONE=
DEMO_EMPLOYEE_NAME=Demo Employee
# Optional: reuse a particular existing employee instead of a demo phone.
DEMO_EMPLOYEE_ID=
